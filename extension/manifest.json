{
  "manifest_version": 3,
  "name": "Waku Download",
  "version": "1.3.0",
  "description": "Gom và tải ảnh đã load trên profile X và Facebook.",
  "minimum_chrome_version": "111",
  "permissions": ["activeTab", "downloads", "storage", "alarms"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" },
  "action": { "default_title": "Mở Waku Download", "default_icon": { "16": "icon16.png", "32": "icon32.png" } },
  "web_accessible_resources": [{ "resources": ["panel.html"], "matches": ["https://x.com/*", "https://twitter.com/*", "https://www.x.com/*", "https://www.twitter.com/*", "https://facebook.com/*", "https://*.facebook.com/*"] }],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://www.x.com/*", "https://www.twitter.com/*", "https://facebook.com/*", "https://*.facebook.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://www.x.com/*", "https://www.twitter.com/*", "https://facebook.com/*", "https://*.facebook.com/*"],
      "js": ["core.js", "facebook.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
